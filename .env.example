# Copie para .env e preencha. Nunca commite .env com secrets.

# Provedor LLM (escolher um)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Alternativa Maritaca (Sabiá)
# LLM_PROVIDER=maritaca
# LLM_API_KEY=
# LLM_MODEL=sabia-3
# LLM_BASE_URL=https://api.maritaca.ai/

# OCR (opcional — cloud)
# OCR_ENGINE=tesseract
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/credentials.json

# Comportamento
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
