# Copie para .env e preencha. Nunca commite .env com secrets.
# Arquitetura provider-agnostic (Fase 4, ver GUIA-IMPLEMENTACAO.md): trocar
# de provedor é trocar estas variáveis, não código. Sem LLM_PROVIDER
# definido, o sistema usa "mock" (determinístico, sem rede, sem API key) —
# é o que os testes automatizados (validate-maketests.sh) usam por padrão.

# Provedor LLM ativo: mock | gemini | anthropic | openai | maritaca
# (openai/maritaca ainda são stubs documentais; anthropic implementado no
# roadmap Q3 Fase 1/3 - ADR-001 - como segundo provider com suporte a vision,
# candidato a "modelo de classe superior" para comparar com Gemini. Ver
# GUIA-IMPLEMENTACAO.md.)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=...          # quando aplicável (endpoint custom/proxy)
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2

# Roadmap Q3 Fase 1 (ADR-001-substituicao-ocr-por-llm-vision.md): flag de
# rollback entre o caminho legado (OCR Tesseract + texto) e o caminho novo
# (envia a imagem do recorte direto ao provider). "off" (default) preserva
# o comportamento de produção atual; "on" ativa o caminho vision. Tem efeito
# real com LLM_PROVIDER=gemini ou anthropic (ambos com suporte a imagem) e
# mock (devolve transcrição fake, só para exercitar o contrato offline).
# Outros provedores (stubs) devolvem erro conservador via a rede de
# segurança de maketests_ext/llm_grader.py, nunca uma exceção não tratada.
LLM_VISION_MODE=off

# Alternativa Anthropic (Claude) — vision suportado desde o roadmap Q3.
# Lembre de trocar LLM_MODEL junto (ex.: claude-sonnet-5, claude-haiku-4-5) -
# LLM_MODEL não é filtrado por provider, cada um lê a mesma variável.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5

# Alternativa Maritaca (Sabiá) — testado: chave autentica, mas sem crédito ativo
# LLM_PROVIDER=maritaca
# LLM_API_KEY=
# LLM_MODEL=sabia-3

# OCR (opcional — cloud, avaliar se Tesseract for insuficiente)
# OCR_ENGINE=tesseract
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/credentials.json
