# Copie para .env e preencha. Nunca commite .env com secrets.
# Arquitetura provider-agnostic (Fase 4, ver GUIA-IMPLEMENTACAO.md): trocar
# de provedor é trocar estas variáveis, não código. Sem LLM_PROVIDER
# definido, o sistema usa "mock" (determinístico, sem rede, sem API key) —
# é o que os testes automatizados (validate-maketests.sh) usam por padrão.

# Provedor LLM ativo: mock | gemini | openai | anthropic | maritaca
# (openai/anthropic/maritaca ainda são stubs documentais, ver GUIA-IMPLEMENTACAO.md)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=...          # quando aplicável (endpoint custom/proxy)
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2

# Roadmap Q3 Fase 1 (ADR-001-substituicao-ocr-por-llm-vision.md): flag de
# rollback entre o caminho legado (OCR Tesseract + texto) e o caminho novo
# (envia a imagem do recorte direto ao provider). "off" (default) preserva
# o comportamento de produção atual; "on" ativa o caminho vision. Só tem
# efeito real com LLM_PROVIDER=gemini (único provider com suporte a imagem
# até aqui) e mock (devolve transcrição fake, só para exercitar o contrato
# offline). Outros provedores (stubs) devolvem erro conservador via a rede
# de segurança de maketests_ext/llm_grader.py, nunca uma exceção não tratada.
LLM_VISION_MODE=off

# Alternativa Maritaca (Sabiá) — testado: chave autentica, mas sem crédito ativo
# LLM_PROVIDER=maritaca
# LLM_API_KEY=
# LLM_MODEL=sabia-3

# OCR (opcional — cloud, avaliar se Tesseract for insuficiente)
# OCR_ENGINE=tesseract
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/credentials.json
